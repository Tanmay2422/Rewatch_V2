{
 "title": "ReWatch Overview",
 "uid": "rewatch",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Requests per second",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(rewatch_http_requests_total[1m])) by (route)",
     "legendFormat": "{{route}} {{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "title": "Error rate (5xx)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(rewatch_http_requests_total{status=~\"5..\"}[1m]))",
     "legendFormat": "{{route}} {{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "title": "p95 latency",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(rewatch_http_request_duration_seconds_bucket[5m])) by (le))",
     "legendFormat": "{{route}} {{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "title": "App up (1 = up)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "up{job=\"rewatch\"}",
     "legendFormat": "{{route}} {{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "title": "Memory (MB)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "process_resident_memory_bytes/1024/1024",
     "legendFormat": "{{route}} {{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "title": "CPU seconds/s",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(process_cpu_seconds_total[1m])",
     "legendFormat": "{{route}} {{status}}",
     "refId": "A"
    }
   ]
  }
 ]
}