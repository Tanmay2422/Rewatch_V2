# Dependencies
node_modules/

# The SQLite database file itself - it's generated data, not source code.
# Each environment (your laptop, the EC2 server) will create its own.
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Secrets - NEVER commit these
*.pem
.env
terraform/terraform.tfvars
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl

# OS / editor noise
.DS_Store
*.log
ansible/inventory.ini
terraform/*.tfstate*
